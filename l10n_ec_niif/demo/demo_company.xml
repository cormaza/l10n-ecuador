<?xml version="1.0" encoding="utf-8" ?>
<odoo>


    <function model="res.users" name="write">
        <value
            eval="[ref('base.user_root'), ref('base.user_admin'), ref('base.user_demo')]"
        />
        <value eval="{'company_ids': [(4, ref('l10n_ec_niif.demo_company_ec'))]}" />
    </function>

    <function model="account.chart.template" name="try_loading">
        <value eval="ref('l10n_ec_niif.ec_chart_template')" />
        <value
            model="res.company"
            eval="obj().env.ref('l10n_ec_niif.demo_company_ec')"
        />
    </function>
</odoo>
